{
  "name": "qms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/deploy-db.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:gen": "cd db && python3 gen.py",
    "edii:ocr": "python3 -I edii/pipeline/ocr.py",
    "edii:parse": "python3 -I edii/pipeline/parse.py",
    "edii:eie": "python3 -I edii/pipeline/eie.py"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "jose": "^5.10.0",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
