# Postgres connection. On Vercel + Neon this is set for you by the Neon integration.
# The schema owner is fine: every request switches to the qms_app role, which RLS applies to.
DATABASE_URL=postgresql://qms_owner:qms@localhost:5432/qms

# Signs session tokens. Generate with: openssl rand -base64 32
QMS_JWT_SECRET=

# Password-less login with the demo accounts. Fine for local testing and throwaway demos,
# never for real data: anyone with the URL can sign in as a demo user.
QMS_DEV_AUTH=true

# On Vercel builds: apply migrations, and load the demo data into an empty database.
QMS_MIGRATE_ON_BUILD=true
QMS_SEED_DEMO=true
